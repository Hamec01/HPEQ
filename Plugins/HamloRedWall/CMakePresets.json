{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "HAMLOREDWALL_JUCE_DIR": "$env{HAMLOREDWALL_JUCE_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": [
        "HamloRedWall_VST3",
        "HamloRedWall_Tests",
        "HamloRedWall_Reference"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": [
        "HamloRedWall_VST3",
        "HamloRedWall_Tests",
        "HamloRedWall_Reference"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
