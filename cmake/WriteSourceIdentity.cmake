file(GLOB_RECURSE identity_sources "${SOURCE_ROOT}/Source/DSP/*" "${SOURCE_ROOT}/Source/Standalone/*")
list(SORT identity_sources)
set(identity_text "${SOURCE_VERSION}")
foreach(source IN LISTS identity_sources)
    file(SHA256 "${source}" part)
    string(APPEND identity_text "${part}")
endforeach()
string(SHA256 identity_hash "${identity_text}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define HAMLO_ECHO_SOURCE_ID \"${identity_hash}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
