set(identity "ZastavaS2SourceV1")
foreach(part "Source/DSP/V2Gate.cpp" "Source/DSP/V2Gate.h")
    file(READ "${SOURCE_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 source "${identity}")
if(NOT DEFINED METHOD_ROOT)
    set(METHOD_ROOT "${SOURCE_ROOT}")
endif()
set(identity "ZastavaS2MethodV1")
foreach(part "Tests/V2LabMain.cpp" "Tools/analyze_zastava_s2.py" "docs/S2_METHODS.md")
    file(READ "${METHOD_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
set(render "unavailable")
if(EXISTS "${METHOD_ROOT}/Tests/V2RenderMain.cpp")
    file(READ "${METHOD_ROOT}/Tests/V2RenderMain.cpp" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 render "${normalized}")
endif()
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define ZASTAVA_S2_SOURCE_ID \"${source}\"\n#define ZASTAVA_S2_METHOD_ID \"${method}\"\n#define ZASTAVA_S2_RENDER_ID \"${render}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
