file(GLOB parts RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/Source/DSP/V2*" "${SOURCE_ROOT}/Source/Standalone/*" "${SOURCE_ROOT}/Source/UI/ShirotaV2Panel.*")
list(APPEND parts "Assets/Hrtf/production.bin" "Assets/Hrtf/production.json")
list(SORT parts)
set(identity "ShirotaS4ProductionV1")
foreach(part IN LISTS parts)
    if(part MATCHES "\\.bin$")
        file(SHA256 "${SOURCE_ROOT}/${part}" fingerprint)
    else()
        file(READ "${SOURCE_ROOT}/${part}" normalized)
        string(REPLACE "\r\n" "\n" normalized "${normalized}")
        string(SHA256 fingerprint "${normalized}")
    endif()
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 result "${identity}")
set(method "ShirotaS4MethodV1")
foreach(part "Tests/IntegrationLabMain.cpp" "Tools/analyze_s4.py" "docs/S4_METHODS.md")
    file(READ "${SOURCE_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND method "${fingerprint}")
endforeach()
string(SHA256 method_id "${method}")
file(SHA256 "${SOURCE_ROOT}/Assets/Hrtf/production.bin" bank_id)
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define SHIROTA_S4_SOURCE_ID \"${result}\"\n#define SHIROTA_S4_METHOD_ID \"${method_id}\"\n#define SHIROTA_S4_BANK_SHA256 \"${bank_id}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
