set(identity "ZastavaPresetDSPV1")
foreach(part "Source/DSP/V2Gate.cpp" "Source/DSP/V2Gate.h" "Source/DSP/LegacyGateProcessor.cpp" "Source/DSP/LegacyGateProcessor.h" "Source/DSP/LegacyZastavaCore.cpp" "Source/DSP/LegacyZastavaCore.h" "Source/DSP/HamloZastava.cpp" "Source/DSP/HamloZastava.h" "Source/Standalone/ModulePluginProcessor.cpp" "Source/Standalone/ModulePluginProcessor.h" "Source/Standalone/ModernParameters.cpp" "Source/Standalone/ModernParameters.h" "Source/Standalone/ModuleVariant.cpp" "Source/Standalone/ModuleVariant.h" "Source/Core/ModulePresets.cpp" "Source/Core/ModulePresets.h" "Source/Core/GenrePresets.cpp")
