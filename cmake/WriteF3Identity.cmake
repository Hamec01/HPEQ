file(GLOB_RECURSE parts RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/Source/*")
list(SORT parts)
set(identity "FaderF3SourceV1")
foreach(part IN LISTS parts)
    file(READ "${SOURCE_ROOT}/${part}" value)
    string(REPLACE "\r\n" "\n" value "${value}")
    string(SHA256 fingerprint "${value}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 source "${identity}")
set(identity "FaderF3MethodV1")
foreach(part "Tests/F3LegacyLab.cpp" "Tests/AllocationAudit.cpp" "Tests/AllocationAudit.h" "docs/F3_METHODS.md")
    file(READ "${SOURCE_ROOT}/${part}" value)
    string(REPLACE "\r\n" "\n" value "${value}")
    string(SHA256 fingerprint "${value}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define FADER_F3_SOURCE_ID \"${source}\"\n#define FADER_F3_METHOD_ID \"${method}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)

set(identity "FaderF3HostMethodV1")
foreach(part "Tests/F3HostMain.cpp" "Tests/AllocationAudit.cpp" "Tests/AllocationAudit.h" "docs/F3_METHODS.md")
    file(READ "${SOURCE_ROOT}/${part}" value)
    string(REPLACE "\r\n" "\n" value "${value}")
    string(SHA256 fingerprint "${value}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 host_method "${identity}")
file(APPEND "${IDENTITY_OUTPUT}" "#define FADER_F3_HOST_METHOD_ID \"${host_method}\"\n")
