file(GLOB_RECURSE parts RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/Source/DSP/*")
list(APPEND parts "CMakeLists.txt" "Source/Core/ModulePresets.cpp" "Source/Core/ModulePresets.h"
    "Source/Standalone/ModulePluginProcessor.cpp" "Source/Standalone/ModulePluginProcessor.h"
    "Source/Standalone/ModuleVariant.cpp" "Source/Standalone/ModuleVariant.h"
    "Source/Standalone/V2Parameters.cpp" "Source/Standalone/V2Parameters.h"
    "Assets/Hrtf/production.bin" "Assets/Hrtf/production.json")
list(SORT parts)
set(identity "ShirotaS5SoundV1")
foreach(part IN LISTS parts)
    if(part MATCHES "\\.bin$")
        file(SHA256 "${SOURCE_ROOT}/${part}" fingerprint)
    else()
        file(READ "${SOURCE_ROOT}/${part}" normalized)
        string(REPLACE "\r\n" "\n" normalized "${normalized}")
        string(SHA256 fingerprint "${normalized}")
    endif()
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 sound "${identity}")
set(identity "ShirotaS5MethodV1")
foreach(part "Tests/PresetLabMain.cpp" "Tools/s5_calibrate.py" "docs/S5_METHODS.md")
    file(READ "${SOURCE_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define SHIROTA_S5_SOUND_ID \"${sound}\"\n#define SHIROTA_S5_METHOD_ID \"${method}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
