set(parts "Source/DSP/SpatialPrototype.cpp" "Source/DSP/SpatialPrototype.h" "Tests/SpatialLabMain.cpp" "Tools/analyze_s2.py" "docs/S2_METHODS.md")
set(identity "ShirotaSpatialS2v1")
foreach(part IN LISTS parts)
    file(SHA256 "${SOURCE_ROOT}/${part}" fingerprint)
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 result "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define SHIROTA_SPATIAL_SOURCE_ID \"${result}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
