file(GLOB_RECURSE parts RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/Source/*")
list(SORT parts)
set(identity "ZastavaS3SourceV1")
foreach(part IN LISTS parts)
    file(READ "${SOURCE_ROOT}/${part}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 fingerprint "${text}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 source "${identity}")
set(identity "ZastavaS3MethodV1")
foreach(part "Tests/S3LegacyLabMain.cpp" "Tests/S3HostLabMain.cpp" "docs/S3_METHODS.md")
    file(READ "${METHOD_ROOT}/${part}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 fingerprint "${text}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define ZASTAVA_S3_SOURCE_ID \"${source}\"\n#define ZASTAVA_S3_METHOD_ID \"${method}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
