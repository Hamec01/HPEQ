set(parts "Assets/Hrtf/horizontal.bin" "Assets/Hrtf/manifest.json" "Source/DSP/MotionPrototype.cpp" "Source/DSP/MotionPrototype.h" "Tests/MotionLabMain.cpp" "Tools/analyze_s3.py" "docs/S3_METHODS.md")
set(identity "ShirotaMotionS3v1")
foreach(part IN LISTS parts)
    file(SHA256 "${SOURCE_ROOT}/${part}" fingerprint)
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 result "${identity}")
file(SHA256 "${SOURCE_ROOT}/Assets/Hrtf/horizontal.bin" bank)
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define SHIROTA_MOTION_SOURCE_ID \"${result}\"\n#define SHIROTA_HRTF_SHA256 \"${bank}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
