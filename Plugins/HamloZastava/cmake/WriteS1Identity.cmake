file(GLOB_RECURSE parts RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/Source/*")
list(SORT parts)
set(identity "ZastavaS1SourceV1")
foreach(part IN LISTS parts)
    file(READ "${SOURCE_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 source "${identity}")
if(NOT METHOD_ROOT)
    set(METHOD_ROOT "${SOURCE_ROOT}")
endif()
set(identity "ZastavaS1MethodV3")
foreach(part "Tests/ZastavaLabMain.cpp" "Tools/verify_zastava_s1.py" "docs/S1_METHODS.md")
    file(READ "${METHOD_ROOT}/${part}" normalized)
    string(REPLACE "\r\n" "\n" normalized "${normalized}")
    string(SHA256 fingerprint "${normalized}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define ZASTAVA_S1_SOURCE_ID \"${source}\"\n#define ZASTAVA_S1_METHOD_ID \"${method}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
