if(REFERENCE)
    file(GLOB_RECURSE parts RELATIVE "${REFERENCE_ROOT}" "${REFERENCE_ROOT}/Source/*")
    list(SORT parts)
    set(prefix "FaderF2ReferenceV1")
    set(root "${REFERENCE_ROOT}")
else()
    set(parts "Source/DSP/FaderKernel.h" "Source/DSP/FaderMeter.h" "Source/DSP/FaderKernel.cpp" "Source/DSP/FaderMeter.cpp")
    set(prefix "FaderF2KernelV1")
    set(root "${SOURCE_ROOT}")
endif()
set(identity "${prefix}")
foreach(part IN LISTS parts)
    file(READ "${root}/${part}" value)
    string(REPLACE "\r\n" "\n" value "${value}")
    string(SHA256 fingerprint "${value}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 source "${identity}")
set(identity "FaderF2MethodV1")
foreach(part "Tests/F2LabMain.cpp" "Tools/analyze_f2.py" "Source/DSP/FaderKernel.h" "Source/DSP/FaderMeter.h" "docs/HAMLOFADER_V2.md")
    file(READ "${SOURCE_ROOT}/${part}" value)
    string(REPLACE "\r\n" "\n" value "${value}")
    string(SHA256 fingerprint "${value}")
    string(APPEND identity "${fingerprint}")
endforeach()
string(SHA256 method "${identity}")
file(WRITE "${IDENTITY_OUTPUT}.tmp" "#pragma once\n#define FADER_F2_SOURCE_ID \"${source}\"\n#define FADER_F2_METHOD_ID \"${method}\"\n")
configure_file("${IDENTITY_OUTPUT}.tmp" "${IDENTITY_OUTPUT}" COPYONLY)
